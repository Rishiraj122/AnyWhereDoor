<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_door"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AnyWhereDoor"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/myName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Files in and out of this phone, no data used"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Door card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/muted" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Door is closed"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="@color/door"
            android:textIsSelectable="true"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/otherAddresses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="Open the door, then connect your laptop or other device to this phone's hotspot."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDoor"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="Open the door"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHotspot"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/btn_ghost"
                android:stateListAnimator="@null"
                android:text="Hotspot"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live transfers -->
    <LinearLayout
        android:id="@+id/activeBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Section"
            android:text="MOVING NOW" />

        <LinearLayout
            android:id="@+id/active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Send in ZIP batches -->
    <Button
        android:id="@+id/btnBatch"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary"
        android:stateListAnimator="@null"
        android:text="Send images to the laptop in ZIPs"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/sendsBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/Section"
            android:text="SENDING IN ZIPS" />

        <LinearLayout
            android:id="@+id/sends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:stateListAnimator="@null"
            android:text="＋  Share files"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnShareFolder"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_ghost"
            android:stateListAnimator="@null"
            android:text="＋  Share a folder"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnClean"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_ghost"
        android:stateListAnimator="@null"
        android:text="Clean cache on all devices"
        android:textAllCaps="false"
        android:textColor="@color/text"
        android:textSize="14sp" />

    <!-- Shelf -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Section"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="ON THE SHELF" />

        <TextView
            android:id="@+id/free"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/shelfEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:text="Nothing here yet. Files sent from the laptop land here, and anything you put on the shelf can be downloaded from the other device."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/shelf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <!-- Log -->
    <TextView
        style="@style/Section"
        android:text="RECENT" />

    <TextView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:text="—"
        android:textColor="@color/muted"
        android:textSize="12sp" />
</LinearLayout>
</ScrollView>
