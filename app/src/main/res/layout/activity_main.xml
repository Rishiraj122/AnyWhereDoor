<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">

    <!-- background art: glowing curve + door, fading into the page -->
    <ImageView android:layout_width="match_parent" android:layout_height="420dp" android:scaleType="centerCrop" android:src="@drawable/bg_door" android:alpha="0.9" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="240dp" android:background="@drawable/bg_fade" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="110dp">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/ic_door" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AnyWhere" android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Door" android:textColor="@color/door" android:textSize="24sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calm, offline file transfer over your hotspot" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <FrameLayout android:id="@+id/btnBell" android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/btn_ghost" android:clickable="true" android:focusable="true" android:contentDescription="Recent activity">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_bell" android:tint="@color/text" android:importantForAccessibility="no" android:layout_gravity="center" />
        </FrameLayout>
        <FrameLayout android:id="@+id/btnSettings" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="10dp" android:background="@drawable/btn_ghost" android:clickable="true" android:focusable="true" android:contentDescription="Settings">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_settings" android:tint="@color/text" android:importantForAccessibility="no" android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- Door card (translucent, the door art glows through on the right) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/card" android:orientation="vertical" android:padding="18dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pill" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp">
            <View android:id="@+id/dot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot" android:backgroundTint="@color/muted" />
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Door is closed" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_phone" android:tint="@color/muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/myName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This phone" android:textColor="@color/muted" android:textSize="13sp" android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/addressRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/address" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="" android:textColor="@color/door" android:textSize="27sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="27sp" android:visibility="gone" />
            <FrameLayout android:id="@+id/btnCopy" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="8dp" android:background="@drawable/btn_ghost" android:clickable="true" android:focusable="true" android:contentDescription="Copy address" android:visibility="gone">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_copy" android:tint="@color/text" android:importantForAccessibility="no" android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <TextView android:id="@+id/otherAddresses" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="2dp" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_laptop" android:tint="@color/muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/hint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:lineSpacingExtra="2dp" android:text="Open the door, then connect your laptop or other device to this phone's hotspot." android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
            
        <LinearLayout android:id="@+id/btnHotspot" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="68dp"  android:background="@drawable/btn_ghost" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_wifi" android:tint="@color/text" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hotspot" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manage hotspot" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
            
        <LinearLayout android:id="@+id/btnDoor" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="68dp" android:layout_marginStart="10dp" android:background="@drawable/btn_primary" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
            <ImageView android:id="@+id/doorIcon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_lock_open" android:tint="@color/bg" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/doorTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open the door" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/doorSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start sharing" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Live transfers -->
    <LinearLayout android:id="@+id/activeBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:minHeight="32dp" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_swap" android:tint="@color/door" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Moving now" android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold" />
        
    </LinearLayout>
        <LinearLayout android:id="@+id/active" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout android:id="@+id/sendsBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:minHeight="32dp" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_zip" android:tint="@color/door" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Sending in ZIPs" android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold" />
        
    </LinearLayout>
        <LinearLayout android:id="@+id/sends" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:orientation="vertical" />
    </LinearLayout>

    <!-- Quick actions -->
    
    <LinearLayout android:id="@+id/quickHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:minHeight="32dp" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_bolt" android:tint="@color/door" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Quick actions" android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold" />
        
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        
        <LinearLayout android:id="@+id/btnBatch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"  android:background="@drawable/tile_hi" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="16dp" android:paddingBottom="14dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_zip" android:tint="@color/door" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Send as ZIP" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="Images to laptop" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/btnShare" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/tile" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="16dp" android:paddingBottom="14dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_file" android:tint="@color/text" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Share files" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="Pick files" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/btnShareFolder" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/tile" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="16dp" android:paddingBottom="14dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_folder" android:tint="@color/text" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Share folder" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="A whole folder" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        
        <LinearLayout android:id="@+id/btnClean" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="68dp"  android:background="@drawable/tile" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_broom" android:tint="@color/text" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clean cache" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="On all devices" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        
        <LinearLayout android:id="@+id/btnStop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="68dp" android:layout_marginStart="10dp" android:background="@drawable/tile_bad" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_stop" android:tint="@color/bad" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stop all" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transfers &amp; temp files" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Shelf: title and free space share one row, nothing gets clipped -->
    
    <LinearLayout android:id="@+id/shelfHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:minHeight="32dp" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder" android:tint="@color/door" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="On the shelf" android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/free" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/muted" android:textSize="13sp" android:layout_marginStart="8dp" /><TextView android:id="@+id/btnSelect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select" android:textColor="@color/door" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="6dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/selectBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/btnSelectAll" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:background="@drawable/btn_ghost" android:stateListAnimator="@null" android:text="Select all" android:textAllCaps="false" android:textColor="@color/text" android:textSize="14sp" />
        <Button android:id="@+id/btnDeleteSel" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/btn_primary" android:stateListAnimator="@null" android:text="Delete" android:textAllCaps="false" android:textColor="@color/bg" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/shelfEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/dashed" android:gravity="center" android:orientation="vertical" android:padding="22dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_inbox" android:tint="@color/door" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nothing here yet" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Files sent from the laptop will appear here." android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="4dp" android:gravity="center" />
    </LinearLayout>

    <LinearLayout android:id="@+id/shelf" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:orientation="vertical" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_folder" android:tint="@color/door" android:importantForAccessibility="no" />
        <TextView android:id="@+id/folder" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="@color/muted" android:textSize="12sp" />
        <LinearLayout android:id="@+id/btnOpenFolder" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/btn_ghost" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="14dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_open" android:tint="@color/text" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open folder" android:textColor="@color/text" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Recent activity -->
    
    <LinearLayout android:id="@+id/recentHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:minHeight="32dp" android:orientation="horizontal">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_clock" android:tint="@color/door" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Recent activity" android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/btnViewAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View all" android:textColor="@color/door" android:textSize="14sp" android:textStyle="bold" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="8dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card" android:orientation="horizontal" android:padding="16dp">
        <View android:layout_width="9dp" android:layout_height="9dp" android:layout_marginTop="6dp" android:background="@drawable/dot" android:backgroundTint="@color/ok" />
        <TextView android:id="@+id/log" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:lineSpacingExtra="5dp" android:text="—" android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
</ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="14dp" android:background="@drawable/nav_bg" android:elevation="8dp" android:orientation="horizontal" android:padding="6dp">
        
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1" android:layout_height="58dp" android:background="@drawable/nav_sel" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" android:tint="@color/door" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="@color/door" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="3dp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/navTransfers" android:layout_width="0dp" android:layout_weight="1" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_swap" android:tint="@color/text" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transfers" android:textColor="@color/text" android:textSize="12sp" android:layout_marginTop="3dp" />
        </LinearLayout>
        
        <LinearLayout android:id="@+id/navShelf" android:layout_width="0dp" android:layout_weight="1" android:layout_height="58dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder" android:tint="@color/text" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shelf" android:textColor="@color/text" android:textSize="12sp" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
