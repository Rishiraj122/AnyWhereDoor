<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#4DF2A65E" /><corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/door" /></shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#40F2A65E" android:endColor="#1AF2A65E" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#99F2A65E" />
        </shape>
    </item>
</selector>
