<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/line" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/door_dark" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#F5B577" android:endColor="#E2914E" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
